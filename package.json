{
  "name": "ribbons",
  "version": "1.0.0",
  "description": "A Vue and TypeScript playground for generative color ribbon identities.",
  "scripts": {
    "dev": "pnpm build:lib && vite --host 0.0.0.0",
    "build": "pnpm build:lib && vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "pnpm build:lib && node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write src packages tests scripts index.html vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src packages tests scripts index.html vite.config.ts tsconfig.json package.json",
    "study": "pnpm build:lib && node --experimental-strip-types scripts/ribbon-study.ts",
    "build:lib": "tsc -p packages/ribbon-core/tsconfig.json",
    "ablate": "pnpm build:lib && node --experimental-strip-types scripts/ablation.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "dependencies": {
    "vue": "^3.5.44",
    "@ribbons/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  },
  "private": true
}
